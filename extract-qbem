function fazerLoginQBEM() {

  const url = "https://eb.qbem.net.br/Autenticacao";

  const payload = {
    ReturnUrl: "/",
    Email: "EMAIL",
    Senha: "SENHA"
  };

  const resposta = UrlFetchApp.fetch(url, {
    method: "post",
    payload: payload,
    followRedirects: false,
    muteHttpExceptions: true
  });

  Logger.log("Status login: " + resposta.getResponseCode());

  const cookies = resposta.getAllHeaders()["Set-Cookie"];

  let cookieFinal = "";

  cookies.forEach(c => {
    let partes = c.split(";")[0];
    const nome = partes.split("=")[0];

    if (
      nome === "session" ||
      nome === "EBSProd" ||
      nome === "ARRAffinity" ||
      nome === "ARRAffinitySameSite"
    ) {
      cookieFinal += partes + "; ";
    }
  });

  Logger.log("Cookie final tamanho: " + cookieFinal.length);

  return cookieFinal;
}

